# URL canônica pública da aplicação (usada em canonical, Open Graph, robots.txt e sitemap.xml)
VITE_SITE_URL=https://clarus.finance
APP_URL=https://clarus.finance

# Google Search Console (opcional — renderiza a meta tag google-site-verification apenas quando preenchida)
VITE_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 / Google Tag Manager (opcionais — carregados somente quando configurados e após consentimento LGPD)
VITE_GA_ID=
VITE_GTM_ID=

# Habilitar banner de consentimento de cookies não essenciais (true | false)
VITE_ENABLE_COOKIE_BANNER=false
